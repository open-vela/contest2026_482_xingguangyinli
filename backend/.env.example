LIVING_CANVAS_HOST=127.0.0.1
LIVING_CANVAS_PORT=8765
LIVING_CANVAS_PUBLIC_BASE_URL=http://127.0.0.1:8765
LIVING_CANVAS_DATA_DIR=./var
# Product backend accepts only explicit, supported provider/model pairs.
# Credentials stay on the server and are never committed or logged.
LIVING_CANVAS_MODEL_BASE_URL=
LIVING_CANVAS_MODEL_API_KEY=
# Supported examples:
# https://api.xiaomimimo.com/v1 + mimo-v2.6-flash|mimo-v2.6-pro
# https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-flash
LIVING_CANVAS_MODEL_NAME=
# Speech endpoints are opt-in. The board owner/product and voice APIs share the
# owner-device token in this candidate; the accessory uses a separate token.
# Both are random runtime secrets and must be rotated with device provisioning.
LIVING_CANVAS_VOICE_API_KEY=
LIVING_CANVAS_VOICE_DEVICE_TOKEN=
LIVING_CANVAS_ACCESSORY_DEVICE_TOKEN=
